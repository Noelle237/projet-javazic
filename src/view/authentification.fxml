<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.AuthentificationController"
      spacing="20" styleClass="auth-dialog"
      stylesheets="@../styles.css">

    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

    <Label fx:id="authTitle" text="Connexion" styleClass="title-lg"/>

    <VBox spacing="8">
        <Label text="Nom d'utilisateur" styleClass="form-label"/>
        <TextField fx:id="fieldUsername" promptText="Entrez votre nom d'utilisateur"
                   styleClass="form-input"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Mot de passe" styleClass="form-label"/>
        <PasswordField fx:id="fieldPassword" promptText="Entrez votre mot de passe"
                       styleClass="form-input"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-text" visible="false"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Annuler" styleClass="btn-ghost" onAction="#handleAnnuler"/>
        <Button text="Se connecter" styleClass="btn-primary" onAction="#handleConnexion"/>
    </HBox>
</VBox>