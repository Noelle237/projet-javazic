<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controlleur.AdminController"
      styleClass="page-content" spacing="24"
      stylesheets="@style.css">

    <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Dashboard Administrateur" styleClass="page-title" HBox.hgrow="ALWAYS"/>
        <Button text="🚪 Déconnexion" styleClass="menu-btn-ghost" onAction="#handleDeconnexion"/>
    </HBox>

    <TabPane styleClass="main-tabs" VBox.vgrow="ALWAYS">

        <Tab text="📊 Statistiques" closable="false">
            <VBox spacing="16">
                <padding><Insets top="16"/></padding>
                <HBox spacing="16">
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="8" prefWidth="160">
                        <Label text="🎵" style="-fx-font-size:32px;"/>
                        <Label fx:id="statMorceaux" text="0" styleClass="stat-value"/>
                        <Label text="Morceaux" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="8" prefWidth="160">
                        <Label text="💿" style="-fx-font-size:32px;"/>
                        <Label fx:id="statAlbums" text="0" styleClass="stat-value"/>
                        <Label text="Albums" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="8" prefWidth="160">
                        <Label text="🎤" style="-fx-font-size:32px;"/>
                        <Label fx:id="statArtistes" text="0" styleClass="stat-value"/>
                        <Label text="Artistes" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="stat-card" alignment="CENTER" spacing="8" prefWidth="160">
                        <Label text="👥" style="-fx-font-size:32px;"/>
                        <Label fx:id="statAbonnes" text="0" styleClass="stat-value"/>
                        <Label text="Abonnés" styleClass="stat-label"/>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="🎵 Catalogue" closable="false">
            <VBox spacing="12">
                <padding><Insets top="16"/></padding>
                <HBox spacing="10">
                    <Button text="+ Ajouter morceau" styleClass="btn-primary" onAction="#handleAjouterMorceau"/>
                    <Button text="+ Ajouter album" styleClass="menu-btn" onAction="#handleAjouterAlbum"/>
                    <Button text="+ Ajouter artiste" styleClass="menu-btn" onAction="#handleAjouterArtiste"/>
                </HBox>
                <TableView fx:id="tableCatalogue" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="250"/>
                        <TableColumn fx:id="colInfo" text="Info" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="👥 Abonnés" closable="false">
            <VBox spacing="12">
                <padding><Insets top="16"/></padding>
                <TableView fx:id="tableAbonnes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUsername" text="Identifiant" prefWidth="200"/>
                        <TableColumn fx:id="colStatut" text="Type" prefWidth="120"/>
                        <TableColumn fx:id="colDateInscription" text="Email" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>
</VBox>